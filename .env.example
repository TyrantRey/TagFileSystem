# Code by AkinoAlice@TyrantRey
# Copy to .env (git-ignored) next to docker-compose.yml. Every value is optional.

# The managed root on the host: must exist and be writable by PUID:PGID.
TFS_ROOT=./data
# Host port for the control channel and the web UI.
TFS_PORT=7411
# uid:gid the daemon runs as, i.e. the owner of the files it creates.
PUID=1000
PGID=1000
TZ=UTC
# How long Docker waits for a clean stop before SIGKILL; keep it above
# [daemon] stop_timeout_seconds in .tfs/config.toml.
TFS_STOP_GRACE=45s
# Poll the root instead of relying on inotify (a root on NFS or SMB).
#WATCHFILES_FORCE_POLLING=true
# Stamp the image with its commit: GIT_COMMIT=$(git rev-parse HEAD) docker compose build
#GIT_COMMIT=
# The image tag docker compose builds and runs.
#TFS_IMAGE_TAG=latest
